<div class="flex flex-col gap-3">
    <form id="password-form" class="flex flex-col gap-3">
        <label
            class="flex flex-col gap-1 text-left text-sm text-gray-400"
        >
            Username
            <input
                name="username"
                type="text"
                autocomplete="username"
                required
                class="rounded-lg bg-gray-900 border border-gray-800 px-3 py-2 text-gray-100 outline-none focus:border-blue-800"
            />
        </label>
        <label
            class="flex flex-col gap-1 text-left text-sm text-gray-400"
        >
            Password
            <input
                name="password"
                type="password"
                autocomplete="current-password"
                required
                class="rounded-lg bg-gray-900 border border-gray-800 px-3 py-2 text-gray-100 outline-none focus:border-blue-800"
            />
        </label>
        <button
            type="submit"
            data-login-action
            class="w-full px-4 py-2 rounded-lg bg-blue-950/80 hover:bg-blue-950 cursor-pointer disabled:opacity-50 disabled:cursor-not-allowed"
        >
            Sign in
        </button>
    </form>
</div>

<script>
    import { hmacSha256Hex } from "../scripts/password";
    import { loginMessage, runLogin, submitLogin } from "../scripts/login";
    import { loginStore, setLogin } from "../store/login";

    const form = document.getElementById(
        "password-form",
    ) as HTMLFormElement | null;

    form?.addEventListener("submit", (event) => {
        event.preventDefault();
        if (loginStore.get().busy) {
            return;
        }

        const data = new FormData(form);
        const username = String(data.get("username") ?? "").trim();
        const password = String(data.get("password") ?? "");

        void runLogin(async () => {
            if (!username || !password) {
                throw new Error("Enter your username and password.");
            }

            setLogin({ status: "Signing in…" });
            const { message, timestamp } = loginMessage();
            const signature = await hmacSha256Hex(password, message);

            await submitLogin({
                user: `password:${username}`,
                signature,
                timestamp,
            });
        });
    });
</script>
