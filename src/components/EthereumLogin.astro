---
import Connect from "./Connect.astro";
---

<div class="flex flex-col gap-3">
    <Connect />
    <button
        type="button"
        data-login-action
        id="ethereum-authenticate"
        class="w-full px-4 py-2 rounded-lg bg-blue-950/80 hover:bg-blue-950 cursor-pointer hidden disabled:opacity-50 disabled:cursor-not-allowed"
    >
        Authenticate
    </button>
</div>

<script>
    import { signMessage } from "@wagmi/core";
    import { toXnodeEthereumUser } from "../lib/xnode-user";
    import { loginMessage, runLogin, submitLogin } from "../scripts/login";
    import { wagmiAdapter } from "../scripts/appkit";
    import { appkitStore } from "../store/appkit";
    import { setLogin } from "../store/login";

    const button = document.getElementById(
        "ethereum-authenticate",
    ) as HTMLButtonElement | null;

    function updateButton() {
        if (!button) {
            return;
        }
        button.classList.toggle("hidden", !appkitStore.account.get());
    }

    appkitStore.account.subscribe(updateButton);
    updateButton();

    button?.addEventListener("click", () => {
        void runLogin(async () => {
            const address = appkitStore.account.get();
            if (!address) {
                throw new Error("No wallet connected.");
            }

            setLogin({
                status: "Please sign the authentication message in your wallet.",
            });

            const { message, timestamp } = loginMessage();
            const adapter = await wagmiAdapter();
            const signature = await signMessage(adapter.wagmiConfig, {
                message,
            });

            await submitLogin({
                user: toXnodeEthereumUser({ address }),
                signature,
                timestamp,
            });
        });
    });
</script>
